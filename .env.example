# ---------------------------------------------------------------------------
# MailWave configuration
# Copy this file to ".env" and fill in your real values.
# If SMTP settings are left blank, MailWave automatically falls back to a
# development preview inbox (Ethereal) so you can test without any account.
# ---------------------------------------------------------------------------

# Port the web server listens on
PORT=3000

# --- SMTP delivery -----------------------------------------------------------
# Examples:
#   Gmail:     smtp.gmail.com : 465  (use an App Password, not your login pw)
#   Outlook:   smtp.office365.com : 587
#   SendGrid:  smtp.sendgrid.net : 587  (user is literally "apikey")
#   Mailgun:   smtp.mailgun.org : 587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465, false for 587/25 (STARTTLS)
SMTP_USER=
SMTP_PASS=

# Default "From" address shown to recipients
MAIL_FROM_NAME=MailWave
MAIL_FROM_EMAIL=no-reply@example.com
